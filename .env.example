# Database Configuration (Neon.tech Cloud PostGIS or Local Docker)
# Neon.tech format: postgresql+asyncpg://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?ssl=require
# Local fallback: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/meridien_db
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?ssl=require

